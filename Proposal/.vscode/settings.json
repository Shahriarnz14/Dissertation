{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.recipes": [
    {
      "name": "CMU proposal (MacTeX pdfLaTeX + BibTeX)",
      "tools": ["cmu-proposal-latexmk"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "cmu-proposal-latexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "cwd": "%DIR%"
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.build.enableMagicComments": true,
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.latex.search.rootFiles.include": ["main.tex"],
  "latex-workshop.latex.autoBuild.run": "onSave"
}
